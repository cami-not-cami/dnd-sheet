<Window x:Class="dnd_sheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dnd_sheet"
        mc:Ignorable="d"
        SizeChanged="Window_SizeChanged" MinHeight="900" MinWidth="900"
        Title="MainWindow" Height="900" Width="600" 
        Background="Black"
        >
    <Grid  Name="MainGrid" RenderOptions.BitmapScalingMode="HighQuality" >
        <Grid.Background>
            <ImageBrush Opacity="0.9" Stretch="Uniform" ImageSource="/sword.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition/>
            <RowDefinition Height="350"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.Background>
                <ImageBrush/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="logo_grid" Grid.ColumnSpan="2">
                <Grid.Background>
                    <ImageBrush ImageSource="/DnD-Symbol.png" Stretch="Uniform"/>
                </Grid.Background>
            </Grid>
            <TextBox x:Name="tb_Name" Grid.Row="1" TextWrapping="Wrap" Background="{x:Null}" Grid.ColumnSpan="2" Foreground="White"/>
            <Label Content="Character Name" Grid.Row="2" Margin="0,0,0,20" FontFamily="Agency FB" FontWeight="Bold" Foreground="#FFFFF5FD">
                <Label.Background>
                    <ImageBrush/>
                </Label.Background>
            </Label>
        </Grid>
        <Grid x:Name="grid_TopRight" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Class &amp; Level" Grid.Row="1" FontFamily="Agency FB" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFF5FD"/>
            <TextBox Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Foreground="White" Background="{x:Null}" BorderBrush="#FF4CBF35"/>
            <Label Content="Race" Grid.Row="3" FontFamily="Agency FB" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFF5FD"/>
            <TextBox Grid.Column="1" Grid.Row="3" TextWrapping="Wrap" BorderBrush="#FF4CBF35" Background="{x:Null}" Foreground="#FFFDFDFD"/>
            <Label Grid.Column="2" Content="Background" Grid.Row="1" FontFamily="Agency FB" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFF5FD"/>
            <TextBox Grid.Column="3" Grid.Row="1" TextWrapping="Wrap" BorderBrush="#FF4CBF35" Background="{x:Null}" Foreground="#FFFDFDFD"/>
            <Label Grid.Column="2" Content="Alignment" Grid.Row="3" FontFamily="Agency FB" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFF5FD"/>
            <TextBox Grid.Column="3" Grid.Row="3" TextWrapping="Wrap" BorderBrush="#FF4CBF35" Background="{x:Null}" Foreground="#FFFDFDFD"/>
            <Label Grid.Column="4" Content="Player Name" Grid.Row="1" FontFamily="Agency FB" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFF5FD"/>
            <TextBox Grid.Column="5" Grid.Row="1" TextWrapping="Wrap" TextChanged="TextBox_TextChanged" BorderBrush="#FF4CBF35" Background="{x:Null}" Foreground="#FFFDFDFD"/>
            <Label Grid.Column="4" Content="Exp. Points" Grid.Row="3" FontFamily="Agency FB" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFF5FD"/>
            <TextBox Grid.Column="5" Grid.Row="3" TextWrapping="Wrap" BorderBrush="#FF4CBF35" Background="{x:Null}" Foreground="#FFFDFDFD"/>
        </Grid>
        <Grid x:Name="grid_BottomRight" Grid.Column="2" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>
            <TextBox TextWrapping="Wrap" Background="{x:Null}" BorderBrush="#FF4CBF35" Foreground="#FFF9F9F9"/>
            <Label Content="Features &amp; Traits" Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Agency FB" FontWeight="Bold" FontSize="11" Background="{x:Null}" Foreground="#FFF9F9F9"/>
        </Grid>
        <Grid x:Name="grid_midRight" Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84*"/>
                <RowDefinition Height="67*"/>
                <RowDefinition Height="26*"/>
                <RowDefinition Height="84*"/>
                <RowDefinition Height="87*"/>
                <RowDefinition Height="87*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <Label Content="Personality Traits" Grid.Row="1" Background="{x:Null}" Foreground="#FFF9F9F9" HorizontalContentAlignment="Center" FontWeight="Bold" FontFamily="Agency FB" VerticalContentAlignment="Stretch" Padding="5,5,5,2"/>
                <TextBox TextWrapping="Wrap" Background="{x:Null}" Foreground="#FFFDFDFD"  FontWeight="Bold"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,3" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <Label Content="Ideals" Grid.Row="1" HorizontalContentAlignment="Center" FontFamily="Agency FB" Foreground="#FFFDFDFD" FontWeight="Bold"/>
                <TextBox TextWrapping="Wrap"  FontWeight="Bold" Background="{x:Null}" Foreground="#FFFDFDFD"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <TextBox TextWrapping="Wrap" Background="{x:Null}" Foreground="#FFFDFDFD"  FontWeight="Bold"/>
                <Label Content="Bonds" Grid.Row="1" Foreground="#FFFDFDFD" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Agency FB" FontWeight="Bold"/>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <TextBox TextWrapping="Wrap" Background="{x:Null}" Foreground="#FFFDFDFD"  FontWeight="Bold"/>
                <Label Content="Flaws" Grid.Row="1" Foreground="#FFFDFDFD" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Agency FB" FontWeight="Bold"/>
            </Grid>
        </Grid>
        <Label Grid.Column="1" Content="Attacks and spellcasting" HorizontalAlignment="Center" Margin="0,379,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="#FFFDFDFD" Height="45" Width="148"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Label Content="Other Proficiencies &amp; Languages" Grid.Row="1" Foreground="#FFFDFDFD" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Agency FB" FontWeight="Bold" FontSize="11"/>
            <TextBox TextWrapping="Wrap" Background="{x:Null}" Foreground="#FFFDFDFD" FontWeight="Bold" BorderBrush="#FF4CBF35"/>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="2" RenderOptions.BitmapScalingMode="HighQuality">
            <Grid.Background>
                <ImageBrush/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="51*"/>
                <ColumnDefinition Width="25*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <TextBox TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged_1" Text="" Foreground="#FFED0808" Grid.Column="1" >
                <TextBox.Background>
                    <ImageBrush ImageSource="/newtoke - Kopie.png" Stretch="Fill" TileMode="None"/>
                </TextBox.Background>
                <TextBox.OpacityMask>
                    <ImageBrush ImageSource="/newtoke - Kopie.png"/>
                </TextBox.OpacityMask>
            </TextBox>
            <TextBox TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged_1" Text="" Foreground="#FFED0808" Grid.Row="1" Grid.Column="1" >
                <TextBox.Background>
                    <ImageBrush ImageSource="/newtoke - Kopie.png" Stretch="Fill"/>
                </TextBox.Background>
                <TextBox.OpacityMask>
                    <ImageBrush ImageSource="/newtoke - Kopie.png"/>
                </TextBox.OpacityMask>
            </TextBox>
            <TextBox TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged_1" Text="" Foreground="#FFED0808" Grid.Row="2" Grid.Column="1" >
                <TextBox.Background>
                    <ImageBrush ImageSource="/newtoke - Kopie.png" Stretch="Fill"/>
                </TextBox.Background>
                <TextBox.OpacityMask>
                    <ImageBrush ImageSource="/newtoke - Kopie.png"/>
                </TextBox.OpacityMask>
            </TextBox>
            <TextBox TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged_1" Text="" Foreground="#FFED0808" Grid.Row="3" Grid.Column="1" >
                <TextBox.Background>
                    <ImageBrush ImageSource="/newtoke - Kopie.png" Stretch="Fill"/>
                </TextBox.Background>
                <TextBox.OpacityMask>
                    <ImageBrush ImageSource="/newtoke - Kopie.png"/>
                </TextBox.OpacityMask>
            </TextBox>
            <TextBox TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged_1" Text="" Foreground="#FFED0808" Grid.Row="4" Grid.Column="1" >
                <TextBox.Background>
                    <ImageBrush ImageSource="/newtoke - Kopie.png" Stretch="Fill"/>
                </TextBox.Background>
                <TextBox.OpacityMask>
                    <ImageBrush ImageSource="/newtoke - Kopie.png"/>
                </TextBox.OpacityMask>
            </TextBox>
            <Label Content="Equipment" Grid.Row="2" FontFamily="Agency FB" FontWeight="Bold" Foreground="White" RenderTransformOrigin="0.5,0.5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>
            </Label>
        </Grid>
    </Grid>
</Window>